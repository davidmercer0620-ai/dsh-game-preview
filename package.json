{
  "name": "dsh-game-preview",
  "version": "0.1.0",
  "private": true,
  "description": "Game preview panel for DeepSeek Harness: run configurations, a playtest bar, and a live stage inside the right sidebar.",
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "gamedev", "preview"],
  "license": "MIT"
}
