{
  "name": "@davidmercer0620-ai/dsh-game-preview",
  "version": "0.10.0",
  "description": "A game studio plugin for DeepSeek Harness: run your game, capture native windows, and play inside the sidebar.",
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/window.js",
    "host/window-capture.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README*.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "game-dev",
    "preview",
    "unity",
    "godot",
    "cocos",
    "wechat-minigame"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/davidmercer0620-ai/dsh-game-preview.git"
  },
  "homepage": "https://github.com/davidmercer0620-ai/dsh-game-preview#readme",
  "bugs": {
    "url": "https://github.com/davidmercer0620-ai/dsh-game-preview/issues"
  }
}
